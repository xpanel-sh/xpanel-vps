APP_NAME=XPanel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cloud.example.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xpanel
DB_USERNAME=xpanel
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
XPANEL_SEED_DEMO_USERS=false
XPANEL_DEMO_ADMIN_PASSWORD=
XPANEL_DEMO_CLIENT_PASSWORD=
XPANEL_ADMIN_LOGIN_PATH=admin/login
XPANEL_CLIENT_LOGIN_PATH=client/login
XPANEL_ADMIN_BASE_PATH=admin
XPANEL_HOME_ENABLED=true
XPANEL_DAEMON_URL=http://127.0.0.1:7070
XPANEL_DAEMON_TOKEN=
XPANEL_NODE_TOKEN=
XPANEL_NATIVE_HOSTING=true
XPANEL_APPLY_SYSTEM_CHANGES=false
XPANEL_SITE_HELPER=/opt/xpanel-vps/scripts/xpanel-site-helper.sh
XPANEL_PACKAGE_HELPER=/opt/xpanel-vps/scripts/xpanel-package-helper.sh
XPANEL_WEB_ROOT=/var/www/xpanel
XPANEL_WEB_SERVERS=nginx,apache
XPANEL_PHP_VERSIONS=8.2,8.3,8.4
XPANEL_HOST_INSTANCES=true
XPANEL_CLOUD_DOMAIN=cloud.example.com
XPANEL_INSTANCE_ROOT=/var/lib/xpanel-vps/instances
XPANEL_HOST_RELEASE=/opt/xpanel-host/current
XPANEL_HOST_VERSION=dev
XPANEL_HOST_PHP_VERSION=8.3
XPANEL_INSTANCE_HELPER=/opt/xpanel-vps/scripts/xpanel-instance-helper.sh
XPANEL_INSTANCE_DEFAULT_MEMORY_MB=512
XPANEL_INSTANCE_DEFAULT_SWAP_MB=0
XPANEL_INSTANCE_DEFAULT_CPU_PERCENT=100
XPANEL_INSTANCE_DEFAULT_TASKS_MAX=256
XPANEL_CONTROL_PLANE_URL=https://cloud.example.com
XPANEL_BROKER_URL=https://cloud.example.com/api/internal/host-broker
XPANEL_HOST_SSO_TTL=60
XPANEL_BROKER_HELPER=/opt/xpanel-vps/scripts/xpanel-host-broker-helper.sh
XPANEL_SERVER_IP=
XPANEL_HOST_PORT_START=10000
XPANEL_HOST_PORT_END=19999
XPANEL_FALLBACK_CERTIFICATE=/etc/xpanel/tls/fallback.crt
XPANEL_FALLBACK_CERTIFICATE_KEY=/etc/xpanel/tls/fallback.key
XPANEL_DOCKER_APPS=false
PHPMYADMIN_URL=/phpmyadmin

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
